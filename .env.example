# Use the same SQL connection and database as alerts-bi-runs.
SQL_HOST=localhost
SQL_PORT=1433
SQL_USER=alerts_bi_app
SQL_PASSWORD=replace-with-database-password
SQL_DATABASE=alerts_bi_dev
SQL_TEST_DATABASE=alerts_bi_test
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true
SQL_REQUEST_TIMEOUT_MS=60000
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8200
ADMIN_USER_HEADER=X-Forwarded-User
# Generate a private random value of at least 32 characters before starting the listener.
ADMIN_SECRET=
# Supply the same registry file used by the runs app (a deployment mount or local copy).
ADMIN_REGISTRY_PATH=config/teams.json
