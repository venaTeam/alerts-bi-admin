# Alerts BI — environment configuration
# Copy to .env and fill in real values. Never commit .env.

# ---- Elasticsearch (alert source) ----
# Local mock started by docker-compose.yml:
ES_URL=http://localhost:9200
# Production ECK uses basic auth; leave blank for the unsecured local mock.
ES_USERNAME=
ES_PASSWORD=
# On-prem TLS with a private CA: path to the certificate bundle.
ES_CA_CERT=
ES_REQUEST_TIMEOUT_MS=60000
ES_PAGE_SIZE=1000

# ---- SQL Server (persistent store) ----
SQL_HOST=localhost
SQL_PORT=1433
SQL_USER=sa
# Must match MSSQL_SA_PASSWORD below. SQL Server requires >=8 chars with
# upper, lower, digit and symbol.
SQL_PASSWORD=Change_me_local_1
SQL_DATABASE=alerts_bi_dev
SQL_TEST_DATABASE=alerts_bi_test
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true
SQL_REQUEST_TIMEOUT_MS=60000

# ---- docker compose (local SQL Server container only) ----
MSSQL_SA_PASSWORD=Change_me_local_1

# ---- LLM (on-prem, OpenAI-SDK compatible) ----
# Leave LLM_ENABLED=false to run the deterministic pipeline with no model calls.
LLM_ENABLED=false
LLM_BASE_URL=https://llm.on-prem.internal/v1
LLM_API_KEY=
# Exact deployment/model identifier; recorded on every run as model_version.
LLM_MODEL=
# Immutable model revision when the deployment name is a mutable alias. Becomes model_version.
LLM_MODEL_REVISION=
# Optional output cap; 0 omits the parameter. Validate endpoint support before setting it.
LLM_MAX_COMPLETION_TOKENS=0
LLM_TIMEOUT_MS=120000
# Hard ceiling on alerts per request (design section 5.1). Never above 200.
LLM_MAX_BATCH_SIZE=200

# ---- opt-in live endpoint validation (tests default to the deterministic fake) ----
LLM_LIVE_TEST=false

# ---- Unified authenticated operator listener ----
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8200
ADMIN_USER_HEADER=X-Forwarded-User
# Private random secret, at least 32 characters.
ADMIN_SECRET=
ADMIN_REGISTRY_PATH=config/teams.json
# Blank uses SQL_DATABASE; affects only the listener.
ADMIN_DATABASE=
ADMIN_OUT_DIR=out
# Preserve the existing mock project's volume identity when moving the checkout.
COMPOSE_PROJECT_NAME=alertsbi
