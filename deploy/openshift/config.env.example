# Non-secret settings: the ConfigMap alerts-bi-config.
# Every alerts-bi-admin container and job reads it, and so does the portal (it uses only SQL_* and LOG_*).
# Copy this file to your private values directory as config.env and fill in each REQUIRED line.
#
# Format (parsed by oc create configmap --from-env-file): KEY=value, one per line. Comments only on
# their own lines. Never quote a value and never leave trailing spaces: both become part of the value.
# An empty value means "use the default".
#
# Credentials do not belong here; they go in secrets.env. Do not add ADMIN_DATABASE,
# ADMIN_REGISTRY_PATH, ADMIN_HOST, ADMIN_PORT, ADMIN_SECRET or ADMIN_USER_HEADER: the templates
# set or forbid them, and the login proxy sends the default identity header.

# ---- SQL Server (admin, its jobs and the portal) ----
# REQUIRED. SQL Server host name or IP address reachable from the cluster.
SQL_HOST=
SQL_PORT=1433
# REQUIRED. The one database shared by the console, the weekly job and the portal.
# The migration init container creates it when absent, if the SQL login may create databases.
SQL_DATABASE=
# true makes every SQL connection require TLS. Change it only by README.md "Turn on SQL encryption".
SQL_ENCRYPT=false
# Keep true. With SQL_ENCRYPT=true, false is refused before any connection: the driver cannot
# validate SQL Server certificates.
SQL_TRUST_SERVER_CERTIFICATE=true
# Per-query timeout in milliseconds. Use at least 1000; it does not limit migrations.
SQL_REQUEST_TIMEOUT_MS=60000

# ---- Elasticsearch, the alert source (admin, run worker, weekly job) ----
# REQUIRED. Base URL, for example https://elasticsearch.example.internal:9200
ES_URL=
# Index names, aliases or read patterns of the v1 and v2 alert schemas. No whitespace.
ES_V1_INDEX=appchi-v1
ES_V2_INDEX=appchi-v2
# Empty when Elasticsearch has a publicly trusted certificate or uses http. For a private CA,
# create the ConfigMap alerts-bi-ca-bundle (README.md) and set /etc/alerts-bi-ca/ca-bundle.crt
ES_CA_CERT=
ES_REQUEST_TIMEOUT_MS=60000
ES_PAGE_SIZE=1000
# Point-in-time lifetime, renewed on every page: a positive number followed by ms, s, m, h or d.
ES_PIT_KEEP_ALIVE=2m
ES_SEARCH_RETRIES=3
ES_SEARCH_RETRY_BACKOFF_MS=1000

# ---- On-prem model (admin, run worker, weekly job) ----
# REQUIRED decision. true calls the model (production). false or empty runs without assessment:
# every weekly week is then held, and the scheduler publishes it anyway, with a reader note,
# three days after it first held it. If unassessed weeks must not be published, keep the
# scheduler suspended (WEEKLY_SUSPEND=true, README.md section 9). Upgrades keep the live value.
LLM_ENABLED=
# REQUIRED when LLM_ENABLED=true. OpenAI-compatible base URL, for example https://llm.example.internal/v1
LLM_BASE_URL=
# REQUIRED when LLM_ENABLED=true. Exact deployment or model identifier; recorded on every run.
LLM_MODEL=
# Immutable model revision when LLM_MODEL is a mutable alias; empty otherwise. At most 128 characters.
LLM_MODEL_REVISION=
LLM_TIMEOUT_MS=120000
# Alerts per model request. Never above 200; may be lowered.
LLM_MAX_BATCH_SIZE=200
# Output token cap; 0 omits the parameter.
LLM_MAX_COMPLETION_TOKENS=0
# When the model endpoint's certificate comes from a private CA, remove the leading "# " from the
# next line and put that CA in alerts-bi-ca-bundle. Never leave SSL_CERT_FILE set but empty.
# SSL_CERT_FILE=/etc/alerts-bi-ca/ca-bundle.crt

# ---- Run worker ----
# Jobs the run worker runs at once, 1 to 8, never two for one team. Empty or 1 runs one job at a
# time. Each extra job adds an Elasticsearch scan, model requests and a week of alerts in memory:
# raise WORKER_MEMORY_LIMIT in values.env with it (README.md "Run several jobs at once").
WORKER_CONCURRENCY=1

# ---- Logging ----
# debug, info, warn or error.
LOG_LEVEL=info
# console: one readable line per record, for oc logs. json: one JSON object per line, only when a
# log collector parses each line.
LOG_FORMAT=console
# Optional. After README.md section 15 has deployed the log collector, remove the leading "# " to
# also send every record to Elasticsearch through it. The console output does not change.
# LOG_FORWARD_URL=http://alerts-bi-logs:9880
# Lowest level sent to Elasticsearch: debug, info, warn or error. Model groups with their alerts
# are info records that only Elasticsearch receives.
LOG_FORWARD_LEVEL=info
