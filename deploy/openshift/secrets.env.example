# Credentials: the Secret alerts-bi-secrets, read by every alerts-bi-admin container and job.
# The portal reads only SQL_USER and SQL_PASSWORD from it, unless PORTAL_SQL_SECRET names another Secret.
# Copy this file to your private values directory as secrets.env, fill it in, create the Secret
# (README.md) and then delete the filled file. Never commit it or paste it into a ticket or chat.
#
# Format (parsed by oc create secret --from-env-file): KEY=value, one per line. Comments only on
# their own lines. Never quote a value: quotes become part of the password.

# REQUIRED. SQL login used by the console, its jobs and, by default, the portal. It runs the
# migrations, so it needs schema-change rights on SQL_DATABASE (db_owner) and must be able to
# connect to master. README.md "SQL login" lists the exact requirements.
SQL_USER=
SQL_PASSWORD=

# Elasticsearch basic authentication; leave both empty when Elasticsearch needs none.
ES_USERNAME=
ES_PASSWORD=

# Model API key; empty when the endpoint needs none.
LLM_API_KEY=
