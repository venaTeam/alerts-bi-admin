# Template values for admin.yaml and admin-job.yaml (oc process --param-file).
# Copy this file to your private values directory as values.env, outside every repository,
# and fill in each REQUIRED line. Keep every other default unless README.md tells you to change it.
#
# Format (parsed by oc): KEY=value, one per line. Do not quote values and do not add text after
# the value; oc treats everything after "#" as a comment.

# REQUIRED. alerts-bi-admin image by digest, built by CI from the release commit:
# <registry>/<repository>@sha256:<64 hex characters>. README.md "Image references" shows how to find it.
ADMIN_IMAGE=

# Console host name. Empty: OpenShift generates <route>-<namespace>.<apps domain>.
# When upgrading, set the host the existing Route uses. The console has no login: anyone with
# this URL who can reach the router may use it.
ADMIN_ROUTE_HOST=

# Router timeout for console requests.
ADMIN_ROUTE_TIMEOUT=30m

# Weekly job schedule in UTC (minute hour day-of-month month day-of-week). It runs daily and
# processes only the weeks that are due. When upgrading, keep the schedule in use today.
WEEKLY_SCHEDULE=30 2 * * *

# true keeps the weekly CronJob suspended. Change to false only in README.md
# "Enable the weekly scheduler", then re-apply admin.yaml.
WEEKLY_SUSPEND=true

# Pull secret for the image. Create it only if the registry needs credentials (README.md).
IMAGE_PULL_SECRET=alerts-bi-pull

# Container sizing. CPU has requests only; memory has a request and a limit.
UI_CPU_REQUEST=100m
UI_MEMORY_REQUEST=256Mi
UI_MEMORY_LIMIT=1Gi
ANALYSIS_CPU_REQUEST=250m
ANALYSIS_MEMORY_REQUEST=512Mi
ANALYSIS_MEMORY_LIMIT=2Gi
# The run-worker container (ANALYSIS_CPU_REQUEST sets its CPU). Raise the limit with
# WORKER_CONCURRENCY in config.env, about the single-job limit times that value.
WORKER_MEMORY_REQUEST=512Mi
WORKER_MEMORY_LIMIT=2Gi
