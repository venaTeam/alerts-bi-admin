# The Elasticsearch that receives the Alerts BI logs: the Secret alerts-bi-logs-es, read only by
# the log collector (logging.yaml). The applications never see it.
# Copy this file to your private values directory as logs-es.env, fill it in, create the Secret
# (README.md 15.3) and then delete the filled file. Never commit it or paste it into a ticket or chat.
#
# Format (parsed by oc create secret --from-env-file): KEY=value, one per line. Comments only on
# their own lines. Never quote a value: quotes become part of the password.

# REQUIRED. Host name of Elasticsearch, without scheme, port or path.
LOGS_ES_HOST=

# REQUIRED. Its port, usually 9200 (or 443 behind a router).
LOGS_ES_PORT=9200

# Basic authentication. The account must be allowed to write documents to the data streams
# <prefix>-runs, <prefix>-admin and <prefix>-portal (Elasticsearch privileges create_doc and
# auto_configure on those names).
# Leave both empty only when Elasticsearch needs no authentication.
LOGS_ES_USER=
LOGS_ES_PASSWORD=
