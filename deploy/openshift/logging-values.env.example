# Template values for logging.yaml, the optional log collector (oc process --param-file).
# Copy this file to your private values directory as logging-values.env, outside every
# repository, and fill in each REQUIRED line. README.md section 15 is the procedure.
#
# Format (parsed by oc): KEY=value, one per line. Do not quote values and do not add text after
# the value; oc treats everything after "#" as a comment.

# REQUIRED. Fluent Bit 5.1.2 by digest in a registry the cluster can pull from:
# <registry>/<repository>@sha256:<64 hex characters>. README.md section 15.1 shows how to mirror it.
LOGS_IMAGE=

# On for an https:// Elasticsearch, Off for http://.
LOGS_ES_TLS=On

# On checks the Elasticsearch certificate. Keep On.
LOGS_ES_TLS_VERIFY=On

# CA that signed the Elasticsearch certificate. Keep the default for a public CA. For a private
# CA put it in alerts-bi-ca-bundle (README.md 6.4) and set /etc/alerts-bi-ca/ca-bundle.crt.
LOGS_ES_CA_FILE=/etc/ssl/certs/ca-certificates.crt

# Data stream names: <prefix>-runs, <prefix>-admin, <prefix>-portal. The Elasticsearch owner
# defines them before the collector first writes (README.md section 15).
LOGS_INDEX_PREFIX=alerts-bi

# Buffer while Elasticsearch is unreachable: the most each data stream may keep, and the
# volume size (at least three times the limit).
LOGS_BUFFER_LIMIT=512M
LOGS_BUFFER_VOLUME=2Gi

# Tries per chunk of records before it is dropped. Retries back off to 15 minutes apart, so 60
# carries the records through roughly eight hours of Elasticsearch outage.
LOGS_RETRY_LIMIT=60

# Pull secret for the image. Create it only if the registry needs credentials (README.md 6.1).
IMAGE_PULL_SECRET=alerts-bi-pull

# Container sizing. CPU has a request only; memory has a request and a limit.
LOGS_CPU_REQUEST=50m
LOGS_MEMORY_REQUEST=64Mi
LOGS_MEMORY_LIMIT=256Mi
