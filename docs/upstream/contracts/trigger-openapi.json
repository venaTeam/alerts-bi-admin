{
  "openapi": "3.1.0",
  "info": {
    "title": "Alerts BI",
    "description": "Starts one team's weekly alert-quality run and serves its scorecard. A wrapper over the same pipeline the command line drives; it performs no analysis of its own, and reports are rendered only from committed SQL rows.",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Liveness and dependency checks",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    },
    "/teams": {
      "get": {
        "summary": "Teams in the ownership registry",
        "operationId": "teams_teams_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamsOut"
                }
              }
            }
          }
        }
      }
    },
    "/runs": {
      "post": {
        "tags": [
          "runs"
        ],
        "summary": "Run one team and return its scorecard",
        "operationId": "create_run_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The scorecard HTML, or a JSON summary for an API caller.",
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/html": {}
            }
          },
          "400": {
            "description": "Unknown team, or a registry the run refused to use"
          },
          "409": {
            "description": "A run is already in progress"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{run_id}": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "Re-render a stored run's scorecard from SQL",
        "operationId": "get_scorecard_runs__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "team",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "required when run_id is \"latest\"",
              "title": "Team"
            },
            "description": "required when run_id is \"latest\""
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{run_id}/{name}": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "One of the four approved outputs, rendered from SQL",
        "operationId": "get_output_runs__run_id___name__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "scorecard.html",
                "daily_metrics.csv",
                "rule_counts.csv",
                "alert_worklist.csv"
              ],
              "type": "string",
              "title": "Name"
            }
          },
          {
            "name": "team",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "required when run_id is \"latest\"",
              "title": "Team"
            },
            "description": "required when run_id is \"latest\""
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/html": {},
              "text/csv": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CheckOut": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "database": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "ok"
        ],
        "title": "CheckOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthOut": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/CheckOut"
            },
            "type": "object",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "version",
          "checks"
        ],
        "title": "HealthOut"
      },
      "RunRequest": {
        "properties": {
          "team": {
            "type": "string",
            "minLength": 1,
            "title": "Team",
            "description": "registry team_id; a run never defaults"
          },
          "run_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run At",
            "description": "freeze run_at (ISO 8601 UTC); defaults to now"
          },
          "llm": {
            "type": "string",
            "enum": [
              "live",
              "fake",
              "off"
            ],
            "title": "Llm",
            "description": "live: the on-prem model; fake: deterministic; off: skip",
            "default": "live"
          }
        },
        "type": "object",
        "required": [
          "team"
        ],
        "title": "RunRequest",
        "description": "The parameters of one run.\n\n``team`` has no default on purpose: a run names one team, and a surface that filled it\nin would turn a scope rule into a convenience."
      },
      "TeamOut": {
        "properties": {
          "team_id": {
            "type": "string",
            "title": "Team Id"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "v1_operators": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "V1 Operators"
          },
          "v2_operator": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "V2 Operator"
          },
          "panels": {
            "type": "integer",
            "title": "Panels"
          }
        },
        "type": "object",
        "required": [
          "team_id",
          "display_name",
          "v1_operators",
          "v2_operator",
          "panels"
        ],
        "title": "TeamOut"
      },
      "TeamsOut": {
        "properties": {
          "teams": {
            "items": {
              "$ref": "#/components/schemas/TeamOut"
            },
            "type": "array",
            "title": "Teams"
          }
        },
        "type": "object",
        "required": [
          "teams"
        ],
        "title": "TeamsOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
