  "components": {
    "schemas": {
      "BackfillOut": {
        "properties": {
          "backfill_id": {
            "type": "string",
            "title": "Backfill Id"
          },
          "team_id": {
            "type": "string",
            "title": "Team Id"
          },
          "llm_mode": {
            "type": "string",
            "enum": [
              "live",
              "fake",
              "off"
            ],
            "title": "Llm Mode"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time",
            "title": "Submitted At"
          },
          "cancelled_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cancelled At"
          },
          "active": {
            "type": "boolean",
            "title": "Active"
          },
          "weeks": {
            "items": {
              "$ref": "#/components/schemas/BackfillWeekOut"
            },
            "type": "array",
            "title": "Weeks"
          }
        },
        "type": "object",
        "required": [
          "backfill_id",
          "team_id",
          "llm_mode",
          "submitted_at",
          "cancelled_at",
          "active",
          "weeks"
        ],
        "title": "BackfillOut",
        "description": "Public backfill state for polling; private keys and the actor are excluded."
      },
      "BackfillWeekOut": {
        "properties": {
          "week_end": {
            "type": "string",
            "format": "date-time",
            "title": "Week End"
          },
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "queued",
              "running",
              "completed",
              "failed",
              "cancelled"
            ],
            "title": "Status"
          },
          "attempts": {
            "type": "integer",
            "title": "Attempts"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "error_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Summary"
          },
          "result_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result Url"
          }
        },
        "type": "object",
        "required": [
          "week_end",
          "job_id",
          "run_id",
          "status",
          "attempts",
          "started_at",
          "completed_at",
          "error_summary",
          "result_url"
        ],
        "title": "BackfillWeekOut",
        "description": "The latest attempt for one week of a backfill."
      },
      "CheckOut": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "database": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "ok"
        ],
        "title": "CheckOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthOut": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/CheckOut"
            },
            "type": "object",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "version",
          "checks"
        ],
        "title": "HealthOut"
      },
      "RunJobOut": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "team_id": {
            "type": "string",
            "title": "Team Id"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "queued",
              "running",
              "completed",
              "failed",
              "cancelled"
            ],
            "title": "Status"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time",
            "title": "Submitted At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "error_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Summary"
          },
          "status_url": {
            "type": "string",
            "title": "Status Url"
          },
          "result_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result Url"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "team_id",
          "run_id",
          "status",
          "submitted_at",
          "started_at",
          "completed_at",
          "error_summary",
          "status_url",
          "result_url"
        ],
        "title": "RunJobOut",
        "description": "Public submission state; private keys, actor and configuration are excluded."
      },
      "RunRequest": {
        "properties": {
          "team": {
            "type": "string",
            "minLength": 1,
            "title": "Team",
            "description": "registry team_id; a run never defaults"
          },
          "run_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run At",
            "description": "Monday 00:00 UTC window end; defaults to the latest completed Monday"
          },
          "llm": {
            "type": "string",
            "enum": [
              "live",
              "fake",
              "off"
            ],
            "title": "Llm",
            "description": "live: the on-prem model; fake: deterministic; off: skip",
            "default": "live"
          }
        },
        "type": "object",
        "required": [
          "team"
        ],
        "title": "RunRequest",
        "description": "The parameters of one run.\n\n``team`` has no default on purpose: a run names one team, and a surface that filled it\nin would turn a scope rule into a convenience."
      },
      "TeamOut": {
        "properties": {
          "team_id": {
            "type": "string",
            "title": "Team Id"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "v1_operators": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "V1 Operators"
          },
          "v2_operator": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "V2 Operator"
          },
          "panels": {
            "type": "integer",
            "title": "Panels"
          }
        },
        "type": "object",
        "required": [
          "team_id",
          "display_name",
          "v1_operators",
          "v2_operator",
          "panels"
        ],
        "title": "TeamOut"
      },
      "TeamsOut": {
        "properties": {
          "teams": {
            "items": {
              "$ref": "#/components/schemas/TeamOut"
            },
            "type": "array",
            "title": "Teams"
          }
        },
        "type": "object",
        "required": [
          "teams"
        ],
        "title": "TeamsOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
