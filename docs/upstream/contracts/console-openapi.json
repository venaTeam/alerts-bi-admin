                },
                {
                  "type": "null"
                }
              ],
              "title": "Error"
            }
          },
          {
            "name": "show",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(all|attention)$",
              "default": "all",
              "title": "Show"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/html": {
